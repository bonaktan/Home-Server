{
  "folders": {},
  "connections": {
    "postgresql-home-server": {
      "provider": "postgresql",
      "driver": "postgres-jdbc",
      "name": "PostgreSQL",
      "save-password": true,
      "configuration": {
        "host": "postgresql",
        "port": "5432",
        "database": "postgres",
        "url": "jdbc:postgresql://postgresql:5432/postgres?sslmode=verify-full&sslrootcert=/etc/cloudbeaver/database-ca.pem",
        "type": "dev"
      }
    },
    "mariadb-home-server": {
      "provider": "mysql",
      "driver": "mariaDB",
      "name": "MariaDB",
      "save-password": true,
      "configuration": {
        "host": "mariadb",
        "port": "3306",
        "database": "",
        "url": "jdbc:mariadb://mariadb:3306/?sslMode=verify-full&serverSslCert=/etc/cloudbeaver/database-ca.pem",
        "type": "dev"
      }
    }
  }
}
