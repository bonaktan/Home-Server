ui = false
disable_mlock = true
api_addr = "https://REMOTE_VPN_NAME:8200"
cluster_addr = "https://REMOTE_VPN_NAME:8201"

storage "raft" {
  path    = "/vault/data"
  node_id = "unseal"
}

listener "tcp" {
  address       = "0.0.0.0:8200"
  tls_cert_file = "/vault/private/server.crt"
  tls_key_file  = "/vault/private/server.key"
}
