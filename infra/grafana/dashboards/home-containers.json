    {
      "title": "Container memory limit used",
      "description": "Working set as a percentage of the configured memory limit. Containers without a meaningful limit are omitted.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bonny"
