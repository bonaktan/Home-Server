    {
      "title": "Container logs",
      "description": "Docker output from all discovered containers. Use the log viewer search to narrow results.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\".+\"}",
          "datasource": {
            "type": "loki",
