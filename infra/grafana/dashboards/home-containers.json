      "targets": [
        {
          "refId": "A",
          "expr": "100 * container_memory_working_set_bytes{name!=\"\"} / (container_spec_memory_limit_bytes{name!=\"\"} > 0 and container_spec_memory_limit_bytes{name!=\"\"} < 1e15)",
