{
  "uid": "home-nginx",
  "title": "Home Server / Nginx",
  "tags": [
    "home-server"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Nginx exporter and server health",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"nginx\"} or nginx_up",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-bonny"
          },
          "legendFormat": "{{__name__}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Connections",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_connections_active or nginx_connections_reading or nginx_connections_writing or nginx_connections_waiting",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-bonny"
          },
          "legendFormat": "{{__name__}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Requests per second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nginx_http_requests_total[5m])",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-bonny"
          },
          "legendFormat": "Requests",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "HTTP responses by status",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate({container=\"infra-nginx\"} | json | __error__=\"\" | status=~\"[1-5][0-9][0-9]\" [5m]))",
          "datasource": {
            "type": "loki",
            "uid": "loki-bonny"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Request duration p95 by host",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {container=\"infra-nginx\"} | json | __error__=\"\" | unwrap request_time | __error__=\"\" [5m])",
          "datasource": {
            "type": "loki",
            "uid": "loki-bonny"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Nginx logs",
      "description": "",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=\"infra-nginx\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki-bonny"
          },
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
