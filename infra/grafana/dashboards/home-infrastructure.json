    {
      "title": "Can Prometheus collect each service?",
      "description": "HEALTHY means the scrape succeeded. DOWN means collection failed; check Prometheus Targets for the last error.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-bonny"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-bonny"
          },
          "legendFormat": "{{job}} / {{instance}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "decimals": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN / SEALED",
                  "color": "red"
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "orientation": "auto"
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 5
      }
    },
